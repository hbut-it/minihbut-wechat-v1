/* pages/rank/rank.wxss */
.rank {
  padding: 0 32rpx;
}

.rank-top {
  display: flex;
  justify-content: space-between;
}

.rank-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.rank-action {
  display: flex;
  align-items: center;
}

.rank-action-card {
  padding: 10rpx 20rpx;
  background-color:#fff;
  border-radius: 16rpx;
  color: #333;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  display: flex;
  align-items: center;
  font-size: 38rpx;
}

.rank-jd {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.jd-item {
  flex: 1;
  text-align: center;
  color: #000;
}

.jd-num {
  margin-top: 5px;
  font-size: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.rank-list {
  padding-bottom: 20px;
}

.rank-card {
  background-color: #fff;
  margin-top: 15px;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  padding: 15px;
  display: flex;
  flex-direction: column;
}

.rank-card-title {
  font-weight: 600;
  margin-bottom: 15px;
  font-size: 18px;
}

.rank-main {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.rank-item {
  text-align: center;
  display: flex;
  flex-direction: column-reverse;
}

.rank-num {
  font-size: 30px;
  font-weight: bold;
  color: var(--td-brand-color);
}

.rank-tip {
  font-size: 12px;
  color: #999;
  margin-bottom: 5px;
}