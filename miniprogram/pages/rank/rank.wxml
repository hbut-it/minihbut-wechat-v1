<!--pages/rank/rank.wxml-->
<image src="../../assets/img/background/gradient.jpg" class="internal-background" />
<t-navbar class="custom-navbar-trans" left-arrow bind:go-back="goBack" fixed="{{ false }}" />
<view class="rank">
  <view class="rank-top">
    <view class="rank-title">我的排名</view>
    <view class="rank-action">
      <view class="rank-action-card" style="margin-right: 20rpx;" bind:tap="doRefreshRank">
        <t-icon name="refresh"></t-icon>
      </view>
      <picker header-text="学期选择" value="{{ termValue }}" range="{{ termList }}" bindchange="handleTermChange">
        <view class="rank-action-card">
          <text style="font-size: 26rpx; margin-right: 8rpx;">{{ termList[termValue] }}</text>
          <t-icon name="chevron-down"></t-icon>
        </view>
      </picker>
    </view>
  </view>
  <view class="rank-jd">
    <view class="jd-item">
      <view class="jd-title">学期平均绩点</view>
      <view class="jd-num"><t-loading theme="spinner" size="24px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.meanScore }}</view>
    </view>
    <view class="jd-item">
      <view class="jd-title">学期算术平均分</view>
      <view class="jd-num"><t-loading theme="spinner" size="24px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.arithmeticMeanScore }}</view>
    </view>
  </view>
  <view class="rank-list">
    <view class="rank-card">
      <view class="rank-card-title">学院（年级）</view>
      <view class="rank-main">
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.collegeRanking }}</view>
          <view class="rank-tip">按平均学分绩点</view>
        </view>
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.arithmeticCollegeRanking }}</view>
          <view class="rank-tip">按算术平均分</view>
        </view>
      </view>
    </view>
    <view class="rank-card">
      <view class="rank-card-title">专业</view>
      <view class="rank-main">
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.professionalRanking }}</view>
          <view class="rank-tip">按平均学分绩点</view>
        </view>
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.arithmeticProfessionRanking }}</view>
          <view class="rank-tip">按算术平均分</view>
        </view>
      </view>
    </view>
    <view class="rank-card">
      <view class="rank-card-title">班级</view>
      <view class="rank-main">
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.classRanking }}</view>
          <view class="rank-tip">按平均学分绩点</view>
        </view>
        <view class="rank-item">
          <view class="rank-num"><t-loading theme="spinner" size="30px" class="wrapper" wx:if="{{ isLoading }}" />{{ rankData.arithmeticClassRanking }}</view>
          <view class="rank-tip">按算术平均分</view>
        </view>
      </view>
    </view>
  </view>
  <view class="rank-tip" style="margin-bottom: 20px; padding: 0 32rpx; text-align: center;">
    平均绩点、算术平均分以及各项排名，所有数据均来自教务系统，小程序仅获取信息并展示，未参与任何计算和排名。
  </view>
</view>