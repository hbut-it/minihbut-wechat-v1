/* pages/about/about.wxss */
.about {
  padding-top: 20px;
  padding-bottom: 15rpx;
}

.about-logo {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
}

.about-logo-container {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 10px;
  flex-direction: column;
  align-items: center;
  font-size: 28px;
  font-weight: bold;
}

.about-title {
  padding: 0 40rpx;
  font-size: 18px;
  line-height: 50px;
  font-weight: bold;
}

.about-card {
  margin-bottom: 20px !important;
}