/* pages/exam/exam.wxss */
.exam {
  padding-bottom: 50rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  min-height: calc(100vh - 220rpx);
  display: flex;
  flex-direction: column;
}

.exam-top {
  width: 100%;
  position: relative;
}

.exam-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 15rpx;
}

.exam-term {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
}

.exam-term-card {
  padding: 10rpx 20rpx;
  background-color:#fff;
  border-radius: 16rpx;
  color: #333;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  display: flex;
  align-items: center;
  font-size: 38rpx;
}

.exam-card {
  background-color: #fff;
  margin-top: 15px;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  padding: 20px;
  display: flex;
  flex-direction: column;
  position: relative;
}

.title {
  font-weight: 600;
  font-size: 42rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-item:not(:last-child) {
  margin-bottom: 5px;
}

.info-item-title {
  color: #777;
  margin-right: 10px;
  font-size: 14px;
}

.exam-print {
  color: rgb(137, 137, 137);
  font-weight: bold;
  font-size: 94rpx;
  position: absolute;
  right: 0;
  bottom: -20rpx;
  font-style: italic;
}