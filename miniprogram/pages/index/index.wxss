/* pages/index/index.wxss */
.index-title {
  font-size: 26px;
  padding-left: 10rpx;
  font-weight: bold;
}

.index {
  padding-top: 10px;
  position: relative;
}

.index-swiper {
  padding: 0 32rpx;
  margin-bottom: 20px;
}

.index-bluebox {
  background-color: var(--td-brand-color);
  position: absolute;
  width: 100%;
  height: 120rpx;
  top: 0;
  left: 0;
  z-index: -1
}

.index-swiper-main {
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
  height: 360rpx;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
}

.index-swiper-item {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.index-container {
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 110rpx) 32rpx;
}

.index-func {
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 20px;
}

.index-func-title {
  font-weight: 600;
  line-height: 48px;
  padding: 0 15px;
  width: 100%;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  font-size: 20px;
}

.index-func-title-block {
  width: 5px;
  background-color: var(--td-brand-color);
  height: 24px;
  margin-right: 8px;
}

.index-notice {
  margin: 0 32rpx;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  margin-bottom: 20px;
}

.index-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 5px;
}