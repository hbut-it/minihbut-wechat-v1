/* pages/index/index.wxss */
.index-nav {
  background-color: var(--td-brand-color);
  height: 300rpx;
}

.index-title {
  padding-top: 90rpx;
  font-size: 28px;
  font-weight: bold;
  padding-left: 32rpx;
  color: #fff;
}

.index-swiper {
  padding: 0 32rpx;
  margin-top: -120rpx;
  margin-bottom: 20px;
}

.index-swiper-main {
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
  height: 360rpx;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
}

.index-swiper-item {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.index-container {
  padding: 0 32rpx 20px 32rpx;
}

.index-func {
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
}

.index-func-title {
  font-weight: 600;
  line-height: 52px;
  padding: 0 15px;
  width: 100%;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  font-size: 20px;
}

.index-func-title-block {
  width: 5px;
  background-color: var(--td-brand-color);
  height: 24px;
  margin-right: 8px;
}

.index-notice {
  margin: 0 32rpx;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  margin-bottom: 20px;
}

.index-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 5px;
}