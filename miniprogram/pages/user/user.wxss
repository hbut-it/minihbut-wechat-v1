/* pages/user/user.wxss */
.user-title {
  font-size: 26px;
  padding-left: 10rpx;
  font-weight: bold;
}

.user {
  position: relative;
  padding-top: 10px;
}

.user-bluebox {
  background-color: var(--td-brand-color);
  position: absolute;
  width: 100%;
  height: 120rpx;
  top: 0;
  left: 0;
  z-index: -1;
}

.user-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.user-main {
  flex: 1;
}

.user-nav-title {
  padding-top: 90rpx;
  font-size: 28px;
  font-weight: bold;
  padding-left: 32rpx;
  color: #fff;
}

.user-card {
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
  padding: 20px;
  margin-left: 32rpx;
  margin-right: 32rpx;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
}

.user-info {
  margin-left: 20px;
  display: flex;
  flex-direction: column;
  width: 100%;
}

.user-cell-group {
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
  margin-bottom: 20px !important;
}

.user-copyright {
  color: #999;
  font-size: 14px;
  text-align: center;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  margin-bottom: 10px;
}