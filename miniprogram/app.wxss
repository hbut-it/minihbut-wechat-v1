/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

page {
  --td-brand-color: #3B95F5;
  background-color: #ececec;
}

.nav {
  background-color: var(--td-brand-color);
  color: #fff;
  font-size: 24px;
  font-weight: bold;
  height: 180rpx;
  position: fixed;
  width: 100%;
  z-index: 12000;
}

.nav-inner {
  display: flex;
  margin-top: 95rpx;
  padding: 0 18rpx;
  align-items: center;
}

.nav-custom {
  padding-top: 210rpx;
}