/**app.wxss**/
@import "./fonts.wxss";

page {
  --td-brand-color: #3b95f5;
  font-family: "MiSans";
}

.internal-background {
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}

.internal-ad-banner {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.08);
}

.custom-navbar {
  --td-navbar-color: #fff;
  --td-navbar-bg-color: var(--td-brand-color);
}

.custom-navbar-trans {
  --td-navbar-bg-color: transparent;
  --td-navbar-color: #fff;
}

.custom-title {
  margin-left: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.custom-capsule {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-capsule__icon {
  flex: 1;
  position: relative;
}

.custom-capsule__icon + .custom-capsule__icon:before {
  content: '';
  display: block;
  position: absolute;
  left: -1px;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 36rpx;
  background: #e7e7e7;
}

.internal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.internal-empty image {
  margin-bottom: 30rpx;
  height: 320rpx;
}

.internal-empty-title {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.internal-empty-tip {
  font-size: 26rpx;
  color: #999;
}